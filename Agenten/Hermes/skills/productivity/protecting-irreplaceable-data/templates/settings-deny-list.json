{
  "_comment": "Drop into .claude/settings.local.json under permissions. Paths starting ./ are relative to the directory holding the settings file. Adjust the Tier 0 directory names to the vault at hand; the Bash/PowerShell entries are universal. Back up the file first and validate the JSON afterwards -- a syntax error means NO permissions are enforced.",

  "permissions": {
    "deny": [
      "Read(**/Zugaenge.md)",
      "Read(**/passwords.*)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.kdbx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/private.pem)",
      "Read(**/.env)",

      "Edit(./Dokumente/**)",
      "Edit(./Bilder/**)",
      "Edit(./Videos/**)",
      "Edit(./Musik/**)",
      "Edit(**/Wissen/**)",
      "Edit(**/.obsidian/**)",

      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(mv:*)",
      "Bash(shred:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(Remove-Item*)",
      "PowerShell(Move-Item*)",
      "PowerShell(Clear-Content*)",

      "PowerShell(*robocopy*/MIR*)",
      "Bash(*robocopy*/MIR*)",
      "Bash(rsync*--delete*)"
    ]
  }
}
