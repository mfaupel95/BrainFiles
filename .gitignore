!Agenten/Werkzeuge/projectatlas/*.ps1
!Agenten/Werkzeuge/projectatlas/*.cmd
!Agenten/Werkzeuge/projectatlas/*.sh
!Agenten/Werkzeuge/projectatlas/*.py
# und ZULETZT die Sperren: es gilt der letzte Treffer, eine spaetere Freigabe
# wuerde die frueheren Sperren aufheben.
Agenten/Hermes/.env
Agenten/Hermes/auth.json
Agenten/Hermes/context_length_cache.yaml
Agenten/Hermes/profiles/*/.env
Agenten/Hermes/profiles/*/auth.json
